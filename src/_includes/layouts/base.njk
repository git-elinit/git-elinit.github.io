<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#2b2931">
    <title>{% if currentPage == "home" %}{{ site.title }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    {% if site.url and page.url %}<link rel="canonical" href="{{ site.url }}{{ page.url | url }}">{% endif %}
    <meta property="og:type" content="{% if ogType %}{{ ogType }}{% else %}website{% endif %}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{% if currentPage == "home" %}{{ site.title }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{{ description or site.description }}">
    {% if site.url and page.url %}<meta property="og:url" content="{{ site.url }}{{ page.url | url }}">{% endif %}
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{% if currentPage == "home" %}{{ site.title }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    <link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}">
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="{{ '/' | url }}" {% if currentPage == "home" %}aria-current="page"{% endif %}>Ellie</a>
        <nav aria-label="Primary navigation">
          <ul class="nav-list" role="list">
            {% for item in site.primaryNavigation %}
              <li><a href="{{ item.url | url }}" {% if currentPage == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="wordmark wordmark-small" href="{{ '/' | url }}">Ellie</a>
        <nav aria-label="Footer navigation">
          <ul class="footer-nav" role="list">
            {% for item in site.footerNavigation %}
              <li><a href="{{ item.url | url }}">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </nav>
        <p class="copyright">© 2026 Ellie</p>
      </div>
    </footer>
  </body>
</html>
