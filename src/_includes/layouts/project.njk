---
layout: layouts/base.njk
ogType: article
---
{% from "components/story-figure.njk" import storyFigure %}
<article class="shell article-shell">
  {% if contentProvidesTitle %}
    <header class="article-kicker">
      <a href="{{ '/projects/' | url }}">← Projects</a>
      <p>{{ projectLabel or "Project" }}</p>
      <span aria-hidden="true">001 / Story</span>
    </header>
  {% else %}
    <header class="article-header">
      <p class="eyebrow">Project</p>
      <h1>{{ title }}</h1>
      {% if subtitle %}<p class="article-standfirst">{{ subtitle }}</p>{% endif %}
      <div class="metadata" aria-label="Article details">
        {% if date %}<time datetime="{{ date | htmlDateString }}">{{ date | dateDisplay }}</time>{% endif %}
        {% if readingTime %}<span>{{ readingTime }}</span>{% endif %}
        {% if platform %}<span>{{ platform }}</span>{% endif %}
        {% if status %}<span>{{ status }}</span>{% endif %}
      </div>
    </header>
  {% endif %}

  {% if image %}
    {{ storyFigure(image) }}
  {% endif %}

  {% if contentMissing %}
    <div class="content-missing" role="status">
      <p>Article content is not available in this local build.</p>
    </div>
  {% else %}
    <div class="article-grid">
      <aside class="article-aside" aria-label="Project navigation">
        <a class="text-link" href="{{ '/projects/' | url }}">← Back to Projects</a>
      </aside>
      <div class="prose article-prose">
        {{ content | safe }}
      </div>
    </div>

    <footer class="article-footer">
      <p>Written by Ellie.</p>
      <a class="text-link" href="{{ '/projects/' | url }}">Back to Projects <span aria-hidden="true">↗</span></a>
    </footer>
  {% endif %}
</article>
